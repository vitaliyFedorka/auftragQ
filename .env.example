# Supabase project credentials (safe to expose on the client — protected by Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (set with `supabase secrets set`, never read by the mobile app):
#   AI_PROVIDER=mock | openai
#   OPENAI_API_KEY=sk-...
